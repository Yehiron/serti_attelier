# Production environment for infra/docker-compose.yml (docs/deployment.md).
#   cp .env.production.example .env.production && chmod 600 .env.production
# Every "CHANGE-ME" must be replaced. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Then run: docker compose -f infra/docker-compose.yml --env-file .env.production exec backend python manage.py check_production

# --- Domain and HTTPS (Caddy) ---------------------------------------------
# Bare domain without scheme; www.<domain> redirects to it.
SITE_DOMAIN=CHANGE-ME.co
# Let's Encrypt account / expiry notices.
ACME_EMAIL=CHANGE-ME@example.com
PUBLIC_SITE_URL=https://CHANGE-ME.co

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=CHANGE-ME
# "backend" and "localhost" are needed for internal calls and health checks.
DJANGO_ALLOWED_HOSTS=CHANGE-ME.co,backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://CHANGE-ME.co
# Unpredictable dashboard path, trailing slash, no leading slash (also used by Caddy).
DJANGO_ADMIN_URL=CHANGE-ME-gestion/
DJANGO_LOG_LEVEL=INFO
API_SCHEMA_PUBLIC=false
INTERNAL_API_TOKEN=CHANGE-ME
COUPON_EMAIL_PEPPER=CHANGE-ME
# Caddy's fixed address on the compose network (infra/docker-compose.yml).
FORWARDED_ALLOW_IPS=172.30.0.10
# WEB_CONCURRENCY=3

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=serti
POSTGRES_USER=serti
POSTGRES_PASSWORD=CHANGE-ME
DATABASE_URL=postgres://serti:CHANGE-ME@db:5432/serti

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Frontend (NEXT_PUBLIC_* are baked in at build time) -----------------
NEXT_PUBLIC_CART_ENABLED=true

# --- Wompi (P-11). Sandbox keys until the client approves going live ------
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Production: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
THROTTLE_WOMPI_EVENTS=120/min

# --- Email (SMTP provider with SPF/DKIM on the domain) --------------------
# Resend (docs/correo.md): EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend,
# EMAIL_HOST_PASSWORD = API key re_... (solo aquí, nunca en el repositorio).
# El remitente debe ser del dominio de la tienda; check_production lo exige.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=SERTI <pedidos@CHANGE-ME.co>
SERTI_ORDERS_EMAIL=

# --- WhatsApp (P-06; "log" sends nothing) ---------------------------------
WHATSAPP_PROVIDER=log
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDERS_RECIPIENT=
WHATSAPP_TEMPLATE_NEW_ORDER=
WHATSAPP_TEMPLATE_NEEDS_ATTENTION=
WHATSAPP_TEMPLATE_LANG=es

# --- Error monitoring (optional) -------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Backups (infra/scripts/backup.sh) -------------------------------------
# age PUBLIC key; keep the private key off the server (password manager + offline copy).
BACKUP_AGE_RECIPIENT=CHANGE-ME-age1...
BACKUP_DIR=/var/backups/serti
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=3

# CMS: mismo secreto aleatorio en Django y Next; vacío desactiva el endpoint (503).
REVALIDATE_SECRET=
FRONTEND_INTERNAL_URL=http://frontend:3000
