# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate a real one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_ALLOWED_HOSTS=serti.localhost,localhost,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://serti.localhost
# Admin dashboard path (no leading slash, trailing slash required). Use an
# unpredictable value outside development.
DJANGO_ADMIN_URL=dashboard/
DJANGO_LOG_LEVEL=INFO
# Expose /api/v1/schema/ (OpenAPI). Keep false in production.
API_SCHEMA_PUBLIC=true

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=serti
POSTGRES_USER=serti
POSTGRES_PASSWORD=serti-dev-password
DATABASE_URL=postgres://serti:serti-dev-password@db:5432/serti

# --- Redis (cache, Celery broker, rate limiting) --------------------------
REDIS_URL=redis://redis:6379/0

