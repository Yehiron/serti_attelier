# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate a real one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_ALLOWED_HOSTS=serti.localhost,localhost,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://serti.localhost
# Admin dashboard path (no leading slash, trailing slash required). Use an
# unpredictable value outside development.
DJANGO_ADMIN_URL=dashboard/
DJANGO_LOG_LEVEL=INFO
# Expose /api/v1/schema/ (OpenAPI). Keep false in production.
API_SCHEMA_PUBLIC=true

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=serti
POSTGRES_USER=serti
POSTGRES_PASSWORD=serti-dev-password
DATABASE_URL=postgres://serti:serti-dev-password@db:5432/serti

# --- Redis (cache, Celery broker, rate limiting) --------------------------
REDIS_URL=redis://redis:6379/0

# --- Added in later phases (see docs/integrations.md) ---------------------
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=
# WOMPI_API_URL=https://sandbox.wompi.co/v1
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# SERTI_ORDERS_EMAIL=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_ORDERS_RECIPIENT=
# WHATSAPP_TEMPLATE_NEW_ORDER=
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# MEDIA_PUBLIC_URL=

# --- Correo (desarrollo) --------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=SERTI <no-reply@serti.localhost>

PUBLIC_SITE_URL=https://serti.localhost

# Shared server-only token; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=

# --- Frontend ---------------------------------------------------------------
# "true" only once the cart exists (Phase 5); until then available pieces
# show a WhatsApp CTA instead of a dead "add to cart" button.
NEXT_PUBLIC_CART_ENABLED=false

# Required in production; independent HMAC pepper for coupon email limits.
COUPON_EMAIL_PEPPER=

# Payments (leave keys empty to disable online checkout)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# Private payment proofs; never expose through the media server
DJANGO_PRIVATE_MEDIA_ROOT=/app/private_media

# --- Transactional notifications (SMTP: SES/Postmark/Resend or any provider) ---
# EMAIL_HOST / EMAIL_PORT / DEFAULT_FROM_EMAIL are defined above for Mailpit.
# Production: set your SMTP host/port and a verified DEFAULT_FROM_EMAIL.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Enable TLS (usually port 587) OR SSL (usually port 465), never both.
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
# Internal order alerts; empty means skip SERTI email.
SERTI_ORDERS_EMAIL=
# log performs no network request; cloud requires Meta verification (P-06).
WHATSAPP_PROVIDER=log
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# E.164 digits, without +; this recipient is SERTI, never the customer.
WHATSAPP_ORDERS_RECIPIENT=
# Approved utility template names; body texts in notifications/adapters.py.
WHATSAPP_TEMPLATE_NEW_ORDER=
WHATSAPP_TEMPLATE_NEEDS_ATTENTION=
WHATSAPP_TEMPLATE_LANG=es
